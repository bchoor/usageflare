{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flareusage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One namespace for the app: plain settings and encrypted secrets (worker/secrets.ts).
  "kv_namespaces": [{ "binding": "KV", "id": "KV_NAMESPACE_ID" }],
  // Cloudflare Access in front of the app; the Worker checks its JWT on every /api call.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
  // Secret (wrangler secret put): SETTINGS_KEY, 32 random bytes in base64, the AES-GCM key.
}
